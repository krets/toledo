#!/usr/bin/env python3
"""
Toledo - task manager CLI, a thin client over the Toledo MCP server.

Config:  ~/.toledo/config.json   (mcp.url, mcp.headers, context, ...)

The first command run without an MCP URL configured starts a setup wizard;
run it again any time with `toledo setup`.

Usage examples:
    toledo ls
    toledo new "Fix login bug" -p 10 -c WEB --due 2026-04-15
    toledo ctx "login bug"; toledo note "Reproduced on staging"
    toledo call set_recurrence task="login bug" interval=7
"""

import argparse
import asyncio
import json
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".toledo" / "config.json"
DEFAULT_MCP_URL = "http://localhost:8001/mcp/sse"
STATES = ["active", "completed", "archive"]


# ── Config ────────────────────────────────────────────────────────────────────

def load_config():
    if CONFIG_PATH.exists():
        return json.loads(CONFIG_PATH.read_text())
    return {}

def save_config(config):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, indent=2))

def get_context():
    return load_config().get("context")

def set_context(ref):
    config = load_config()
    if ref:
        config["context"] = ref
    else:
        config.pop("context", None)
    save_config(config)

def fail(msg, code=1):
    print(f"✗ {msg}", file=sys.stderr)
    raise SystemExit(code)


# ── MCP client ────────────────────────────────────────────────────────────────

class McpError(Exception):
    pass


def _leaf(exc):
    """The innermost real error inside anyio's exception groups."""
    while isinstance(exc, BaseExceptionGroup) and exc.exceptions:
        exc = exc.exceptions[0]
    return exc


async def _with_session(url, headers, fn):
    import httpx
    import logging
    from mcp import ClientSession
    from mcp.client.streamable_http import streamable_http_client

    # The client library logs warnings (e.g. unknown tool) that duplicate the
    # error the CLI already prints.
    for name in ("mcp", "client"):
        logging.getLogger(name).setLevel(logging.ERROR)
    timeout = httpx.Timeout(30, read=300)
    async with httpx.AsyncClient(headers=headers, timeout=timeout) as http:
        async with streamable_http_client(url, http_client=http) as (read, write, _):
            async with ClientSession(read, write) as session:
                await session.initialize()
                return await fn(session)


def run_session(fn, url=None, headers=None):
    mcp_cfg = load_config().get("mcp", {})
    url = url or mcp_cfg.get("url")
    headers = headers if headers is not None else mcp_cfg.get("headers", {})
    try:
        return asyncio.run(_with_session(url, headers, fn))
    except Exception as e:
        e = _leaf(e)
        status = getattr(getattr(e, "response", None), "status_code", None)
        if status in (401, 403):
            raise McpError(f"{url} rejected the credentials (HTTP {status}); run `toledo setup`")
        raise McpError(f"Could not reach MCP server at {url}: {e}") from None


def call_tool(tool, /, **args):
    """Call a tool and return its text. Tool-level errors exit non-zero."""
    args = {k: v for k, v in args.items() if v is not None}

    async def go(session):
        return await session.call_tool(tool, args)

    ensure_mcp()
    try:
        result = run_session(go)
    except McpError as e:
        fail(str(e))
    text = "\n".join(c.text for c in result.content if getattr(c, "type", "") == "text")
    if result.isError or text.startswith("Error:"):
        fail(text.removeprefix("Error:").strip())
    return text


def out(tool, /, **args):
    print(call_tool(tool, **args))


# ── Setup wizard ──────────────────────────────────────────────────────────────

def probe(url, headers):
    """POST an MCP initialize; return the HTTP status (0 if unreachable)."""
    import httpx
    body = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2025-03-26", "capabilities": {},
                       "clientInfo": {"name": "toledo-cli", "version": "1"}}}
    try:
        r = httpx.post(url, json=body, timeout=10, headers={
            **headers, "Accept": "application/json, text/event-stream"})
        return r.status_code
    except httpx.HTTPError:
        return 0


def ask(prompt, default=None):
    suffix = f" [{default}]" if default else ""
    answer = input(f"{prompt}{suffix}: ").strip()
    return answer or (default or "")


def ask_auth():
    print("The server needs authentication. How should the CLI send it?")
    print("  1) Bearer token (Authorization: Bearer ...)")
    print("  2) access_token cookie")
    print("  3) Custom header")
    choice = ask("Choice", "1")
    if choice == "3":
        name = ask("Header name")
        return {name: ask(f"{name} value")} if name else {}
    token = ask("Token")
    if not token:
        return {}
    if choice == "2":
        return {"Cookie": f"access_token={token}"}
    return {"Authorization": f"Bearer {token}"}


def wizard():
    print("Toledo setup — connect the CLI to your Toledo MCP server.\n")
    config = load_config()
    current = config.get("mcp", {})
    url = ask("MCP server URL", current.get("url") or DEFAULT_MCP_URL)
    headers = dict(current.get("headers", {}))

    while True:
        status = probe(url, headers)
        if status in (401, 403):
            if headers:
                print(f"✗ {url} rejected those credentials (HTTP {status}).")
            new_headers = ask_auth()
            if new_headers:
                headers = new_headers
                continue
            print("✗ No credentials given.")
        elif status == 0:
            print(f"✗ Could not connect to {url}.")
        elif status >= 400:
            print(f"✗ {url} answered HTTP {status}; is this the MCP endpoint (usually …/mcp/sse)?")
        else:
            try:
                tools = run_session(lambda s: s.list_tools(), url=url, headers=headers).tools
                print(f"✓ Connected: {len(tools)} tools available.")
                break
            except McpError as e:
                print(f"✗ {e}")
        if ask("Try a different URL? (y/n)", "y").lower().startswith("y"):
            url = ask("MCP server URL", url)
            continue
        if not ask("Save these settings anyway? (y/n)", "n").lower().startswith("y"):
            fail("Setup cancelled; nothing saved.")
        break

    config["mcp"] = {"url": url, "headers": headers}
    save_config(config)
    print(f"✓ Saved to {CONFIG_PATH}")


def ensure_mcp():
    if load_config().get("mcp", {}).get("url"):
        return
    if not sys.stdin.isatty():
        fail("No MCP server configured. Run `toledo setup` or `toledo config mcp.url <url>`.")
    wizard()
    print()


# ── Commands ──────────────────────────────────────────────────────────────────

def task_or_ctx(args):
    ref = getattr(args, "task", None) or get_context()
    if not ref:
        fail("No task given and no context set. Pass -t TASK or run `toledo ctx TASK`.")
    return ref


def cmd_setup(args):
    wizard()


def cmd_status(args):
    out("list_tasks", state="all" if args.all else (args.state or "active"),
        project=args.project, sort="recent" if args.recent else None,
        updated_within_days=args.days)


def cmd_show(args):
    out("get_task", task=task_or_ctx(args))


def cmd_new(args):
    out("create_task", name=args.name, project=args.project, priority=args.priority,
        due=args.due, recurrence=args.recur, description=args.description)


def cmd_done(args):
    out("done_task", task=args.task, note=args.note)


def cmd_move(args):
    out("move_task", task=args.task, state=args.to)


def cmd_archive(args):
    out("move_task", task=args.task, state="archive")


def cmd_cancel(args):
    print(call_tool("set_recurrence", task=args.task, interval=0))
    out("done_task", task=args.task)


def cmd_rm(args):
    if not args.yes:
        answer = input(f"Delete task matching '{args.task}' permanently? [y/N] ")
        if answer.strip().lower() != "y":
            print("Aborted."); return
    out("delete_task", task=args.task)


def cmd_rename(args):
    out("rename_task", task=args.task, name=args.name)


def cmd_reprioritize(args):
    out("reprioritize_task", task=args.task, priority=args.priority)


def cmd_reproject(args):
    out("reproject_task", task=args.task, project=args.project)


def cmd_due(args):
    out("set_due", task=task_or_ctx(args), due=args.date)


def cmd_recur(args):
    out("set_recurrence", task=task_or_ctx(args), interval=args.days)


def cmd_note(args):
    out("add_note", task=task_or_ctx(args), note=args.text)


def cmd_edit(args):
    out("update_description", task=task_or_ctx(args), description=args.text)


def cmd_sub(args):
    out("add_subtask", task=task_or_ctx(args), name=args.name,
        priority=args.priority, due=args.due)


def cmd_subdone(args):
    out("done_subtask", task=task_or_ctx(args), subtask=args.name)


def cmd_subrm(args):
    if not args.yes:
        answer = input(f"Delete subtask matching '{args.name}' permanently? [y/N] ")
        if answer.strip().lower() != "y":
            print("Aborted."); return
    out("delete_subtask", task=task_or_ctx(args), subtask=args.name)


def cmd_search(args):
    out("search_tasks", query=args.query)


def cmd_upcoming(args):
    out("upcoming_tasks", days=args.days)


def cmd_ctx(args):
    ref = args.task
    if ref == "clear":
        set_context(None); print("✓ Context cleared."); return
    if ref == "show":
        ctx = get_context()
        print(f"Context: {ctx}" if ctx else "No context set."); return
    # Resolve through the server so the context is the task's slug.
    detail = call_tool("get_task", task=ref)
    slug = next((ln.split(":", 1)[1].strip() for ln in detail.splitlines()
                 if ln.startswith("Slug:")), ref)
    set_context(slug)
    print(f"✓ Context → '{slug}'")


def cmd_proj(args):
    if args.remove:
        out("remove_project", project=args.remove)
    elif args.rename:
        out("rename_project", project=args.rename[0], name=args.rename[1])
    elif args.merge:
        out("merge_projects", from_project=args.merge[0], into_project=args.merge[1])
    elif args.name:
        out("add_project", name=args.name, color=args.color)
    else:
        out("list_projects")


def cmd_glossary(args):
    if args.term and args.canonical:
        out("update_glossary", term=args.term, canonical=args.canonical)
    elif args.term:
        fail("Give both TERM and CANONICAL to add an entry.")
    else:
        out("get_resource", uri="toledo://glossary")


def cmd_prompt(args):
    if args.name:
        out("get_prompt", name=args.name)
    else:
        out("list_prompts")


def cmd_tools(args):
    ensure_mcp()
    try:
        tools = run_session(lambda s: s.list_tools()).tools
    except McpError as e:
        fail(str(e))
    for t in tools:
        params = ", ".join(
            p + ("" if p in t.inputSchema.get("required", []) else "?")
            for p in t.inputSchema.get("properties", {})
        )
        print(f"{t.name}({params})")
        if args.verbose and t.description:
            print(f"    {t.description}")


def cmd_call(args):
    params = {}
    for pair in args.params:
        key, sep, value = pair.partition("=")
        if not sep:
            fail(f"Expected key=value, got '{pair}'")
        try:
            params[key] = json.loads(value)
        except json.JSONDecodeError:
            params[key] = value
    out(args.tool, **params)


def cmd_config(args):
    config = load_config()
    if not args.key:
        print(json.dumps(config, indent=2))
        return

    parts = args.key.split(".")

    if args.value is None and not args.unset:
        val = config
        for p in parts:
            if isinstance(val, dict) and p in val:
                val = val[p]
            else:
                val = None; break
        if val is not None:
            print(val if not isinstance(val, (dict, list)) else json.dumps(val))
        return

    if args.unset:
        val = config
        for p in parts[:-1]:
            if p in val and isinstance(val[p], dict):
                val = val[p]
            else:
                return
        if parts[-1] in val:
            del val[parts[-1]]
            save_config(config)
            print(f"✓ Unset {args.key}")
        return

    val = config
    for p in parts[:-1]:
        if p not in val or not isinstance(val[p], dict):
            val[p] = {}
        val = val[p]

    new_val = args.value
    # Try to parse as JSON for bools/ints/etc, fallback to string
    try:
        new_val = json.loads(args.value)
    except json.JSONDecodeError:
        pass

    val[parts[-1]] = new_val
    save_config(config)
    print(f"✓ {args.key} = {new_val}")


# ── Chat (talks to the web server's /api/chat, not the MCP server) ────────────

class Spinner:
    def __init__(self, message="Thinking..."):
        self.message = message
        self.stop_running = False
        self.thread = None

    def _spin(self):
        import time
        chars = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        i = 0
        while not self.stop_running:
            sys.stdout.write(f"\r {chars[i]} {self.message}")
            sys.stdout.flush()
            i = (i + 1) % len(chars)
            time.sleep(0.1)
        sys.stdout.write("\r" + " " * (len(self.message) + 10) + "\r")
        sys.stdout.flush()

    def __enter__(self):
        import threading
        self.stop_running = False
        self.thread = threading.Thread(target=self._spin)
        self.thread.start()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.stop_running = True
        if self.thread:
            self.thread.join()


def cmd_chat(args):
    import requests

    url = load_config().get("remote", {}).get("url")
    server_url = url.rstrip("/") if url else "http://localhost:8000"

    messages = []

    if args.message:
        messages.append({"role": "user", "content": " ".join(args.message)})
        try:
            with Spinner():
                r = requests.post(f"{server_url}/api/chat", json={"messages": messages})
                r.raise_for_status()
                res = r.json()
            print(f"\n{res.get('message')}\n")
        except Exception as e:
            print(f"✗ Error: {e} (Is the server running?)")
        return

    print(f"Chatting with Toledo ({server_url}). Type 'exit' to quit.\n")
    while True:
        try:
            user_input = input("user> ")
            if user_input.lower() in ("exit", "quit"): break
            if not user_input.strip(): continue

            messages.append({"role": "user", "content": user_input})

            with Spinner():
                r = requests.post(f"{server_url}/api/chat", json={"messages": messages})
                r.raise_for_status()
                res = r.json()

            # Update history from server (compacted if needed)
            messages = res.get("history", messages)

            print(f"ai> {res.get('message')}\n")

        except KeyboardInterrupt:
            print("\nInterrupted."); break
        except Exception as e:
            print(f"\n✗ Error: {e} (Is the server running?)")


# ── CLI wiring ────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(prog="toledo", description="Toledo task manager (MCP client)")
    s = p.add_subparsers(dest="command")

    s.add_parser("setup", help="Configure the MCP server connection")

    ps = s.add_parser("status", aliases=["ls"], help="List tasks")
    ps.add_argument("-a", "--all", action="store_true", help="All states")
    ps.add_argument("-s", "--state", choices=STATES)
    ps.add_argument("-c", "--project", metavar="NAME")
    ps.add_argument("-r", "--recent", action="store_true", help="Newest updates first")
    ps.add_argument("--days", type=int, help="Only tasks updated within N days")

    psh = s.add_parser("show", aliases=["log", "worklog"], help="Show a task in full")
    psh.add_argument("task", nargs="?")

    pn = s.add_parser("new", help="Create a task")
    pn.add_argument("name")
    pn.add_argument("-p", "--priority", type=int, help="1–99, higher = more important (default 50)")
    pn.add_argument("-c", "--project")
    pn.add_argument("-d", "--description")
    pn.add_argument("--due", metavar="YYYY-MM-DD")
    pn.add_argument("--recur", type=int, metavar="DAYS")

    pd = s.add_parser("done", help="Complete a task (advances recurring ones)")
    pd.add_argument("task")
    pd.add_argument("-n", "--note", help="Closing note")

    pm = s.add_parser("move", aliases=["mv"], help="Move a task to another state")
    pm.add_argument("task")
    pm.add_argument("to", choices=STATES)

    par = s.add_parser("archive", help="Archive a task")
    par.add_argument("task")

    pc = s.add_parser("cancel", help="Stop a recurring task and complete it")
    pc.add_argument("task")

    prm = s.add_parser("rm", help="Delete a task")
    prm.add_argument("task")
    prm.add_argument("-y", "--yes", action="store_true", help="Don't ask for confirmation")

    prn = s.add_parser("rename", help="Rename a task")
    prn.add_argument("task")
    prn.add_argument("name")

    pre = s.add_parser("reprioritize", aliases=["pri"], help="Change priority")
    pre.add_argument("task")
    pre.add_argument("priority", type=int, help="1–99, higher = more important")

    prp = s.add_parser("reproject", help="Move a task to another project")
    prp.add_argument("task")
    prp.add_argument("project")

    pdu = s.add_parser("due", help="Set due date ('' clears)")
    pdu.add_argument("date", metavar="YYYY-MM-DD")
    pdu.add_argument("-t", "--task")

    prc = s.add_parser("recur", help="Set recurrence in days (0 clears)")
    prc.add_argument("days", type=int)
    prc.add_argument("-t", "--task")

    pnt = s.add_parser("note", help="Add a note")
    pnt.add_argument("text")
    pnt.add_argument("-t", "--task")

    pe = s.add_parser("edit", help="Replace the description")
    pe.add_argument("text")
    pe.add_argument("-t", "--task")

    psub = s.add_parser("sub", help="Add a subtask")
    psub.add_argument("name")
    psub.add_argument("-t", "--task")
    psub.add_argument("-p", "--priority", type=int, help="1–99, higher = more important")
    psub.add_argument("--due", metavar="YYYY-MM-DD")

    psd = s.add_parser("subdone", help="Complete a subtask")
    psd.add_argument("name")
    psd.add_argument("-t", "--task")

    psrm = s.add_parser("subrm", help="Delete a subtask")
    psrm.add_argument("name")
    psrm.add_argument("-t", "--task")
    psrm.add_argument("-y", "--yes", action="store_true")

    psr = s.add_parser("search", help="Search tasks")
    psr.add_argument("query")

    pup = s.add_parser("upcoming", aliases=["today"], help="Tasks due soon")
    pup.add_argument("--days", type=int, default=7)

    px = s.add_parser("ctx", help="Set/show/clear the current task")
    px.add_argument("task", nargs="?", default="show")

    pp = s.add_parser("proj", help="List/add/remove/rename/merge projects")
    pp.add_argument("name", nargs="?", help="Add a project with this name")
    pp.add_argument("--color", metavar="HEX")
    pp.add_argument("-r", "--remove", metavar="NAME")
    pp.add_argument("--rename", nargs=2, metavar=("OLD", "NEW"))
    pp.add_argument("--merge", nargs=2, metavar=("FROM", "INTO"))

    pg = s.add_parser("glossary", help="Show glossary, or add TERM CANONICAL")
    pg.add_argument("term", nargs="?")
    pg.add_argument("canonical", nargs="?")

    ppr = s.add_parser("prompt", help="List guided-session prompts, or show one")
    ppr.add_argument("name", nargs="?")

    pt = s.add_parser("tools", help="List the server's MCP tools")
    pt.add_argument("-v", "--verbose", action="store_true")

    pca = s.add_parser("call", help="Call any MCP tool: call TOOL key=value ...")
    pca.add_argument("tool")
    pca.add_argument("params", nargs="*")

    pch = s.add_parser("chat", help="Chat with the web server's assistant")
    pch.add_argument("message", nargs="*")

    pcfg = s.add_parser("config", help="Get/set config values (dotted keys)")
    pcfg.add_argument("key", nargs="?")
    pcfg.add_argument("value", nargs="?")
    pcfg.add_argument("--unset", action="store_true")

    args = p.parse_args()

    dispatch = {
        "setup": cmd_setup,
        "status": cmd_status, "ls": cmd_status,
        "show": cmd_show, "log": cmd_show, "worklog": cmd_show,
        "new": cmd_new, "done": cmd_done,
        "move": cmd_move, "mv": cmd_move,
        "archive": cmd_archive, "cancel": cmd_cancel, "rm": cmd_rm,
        "rename": cmd_rename,
        "reprioritize": cmd_reprioritize, "pri": cmd_reprioritize,
        "reproject": cmd_reproject,
        "due": cmd_due, "recur": cmd_recur,
        "note": cmd_note, "edit": cmd_edit,
        "sub": cmd_sub, "subdone": cmd_subdone, "subrm": cmd_subrm,
        "search": cmd_search, "upcoming": cmd_upcoming, "today": cmd_upcoming,
        "ctx": cmd_ctx, "proj": cmd_proj, "glossary": cmd_glossary,
        "prompt": cmd_prompt, "tools": cmd_tools, "call": cmd_call,
        "chat": cmd_chat, "config": cmd_config,
    }

    if args.command in dispatch:
        dispatch[args.command](args)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
